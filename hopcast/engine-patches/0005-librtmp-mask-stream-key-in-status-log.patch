--- a/plugins/obs-outputs/librtmp/rtmp.c
+++ b/plugins/obs-outputs/librtmp/rtmp.c
@@ -3200,6 +3200,34 @@ HandleInvoke(RTMP *r, const char *body, unsigned int nBodySize)
     AMFProp_GetString(AMF_GetProp(&obj2, &av_level, -1), &level);
     AMFProp_GetString(AMF_GetProp(&obj2, &av_description, -1), &description);
     if (code.av_val) {
+        /* HopCast: servers often echo the stream name, i.e. the stream key, in the
+         * description ("<key> is now published"); never write it to the log.
+         * (curStreamIdx has already moved past the stream being published here,
+         * so check every stream's playpath.) */
+        char descSafe[512];
+        const char *desc = description.av_val ? description.av_val : "noDesc";
+        if (description.av_val && r->Link.nStreams > 0) {
+            size_t o = 0;
+            for (const char *c = description.av_val; *c && o + 4 < sizeof(descSafe);) {
+                int skip = 0;
+                for (int si = 0; si < r->Link.nStreams && si < RTMP_MAX_STREAMS; si++) {
+                    const AVal *pp = &r->Link.streams[si].playpath;
+                    if (pp->av_val && pp->av_len > 0 && strncmp(c, pp->av_val, (size_t)pp->av_len) == 0) {
+                        skip = pp->av_len;
+                        break;
+                    }
+                }
+                if (skip) {
+                    memcpy(descSafe + o, "***", 3);
+                    o += 3;
+                    c += skip;
+                } else {
+                    descSafe[o++] = *c++;
+                }
+            }
+            descSafe[o] = '\0';
+            desc = descSafe;
+        }
         RTMP_Log(RTMP_LOGINFO, "[rtmp io] server->client 0x%X method=%s \n" \
             "\t level:%s \n"\
             "\t code:%s \n"\
@@ -3207,7 +3235,7 @@ HandleInvoke(RTMP *r, const char *body, unsigned int nBodySize)
