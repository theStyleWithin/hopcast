# Template for fdroiddata: metadata/io.github.thestylewithin.hopcast.yml (the file name is the app id).
# The release workflow fills the @...@ marks for each version. Test with `fdroid build` before submitting.
# The Android project is in android/ (Gradle). versionCode is major*10000 + minor*100 + patch of hopcast/VERSION.
Categories:
  - Multimedia
  - Internet
License: GPL-2.0-or-later
AuthorName: theStyleWithin
WebSite: https://github.com/theStyleWithin/hopcast
SourceCode: https://github.com/theStyleWithin/hopcast
IssueTracker: https://github.com/theStyleWithin/hopcast/issues

AutoName: HopCast
Summary: Stream or record your phone screen, no account and no nudges

RepoType: git
Repo: https://github.com/theStyleWithin/hopcast.git

Builds:
  - versionName: '@VERSION_NAME@'
    versionCode: @VERSION_CODE@
    commit: @COMMIT@
    subdir: @ANDROID_PROJECT_DIR@/app
    gradle:
      - yes

AutoUpdateMode: Version
UpdateCheckMode: Tags
CurrentVersion: '@VERSION_NAME@'
CurrentVersionCode: @VERSION_CODE@
