# Maintainer: theStyleWithin <https://github.com/theStyleWithin>
# Generated by the hopcast-app release job from hopcast/packaging/aur/PKGBUILD.in.
pkgname=hoppercast-bin
pkgver=@PKGVER@
_tag=@TAG@
pkgrel=1
pkgdesc="Live streaming and recording studio for Linux: no account, no telemetry, any RTMP/SRT/RIST server"
arch=('x86_64')
url="https://github.com/theStyleWithin/hoppercast"
license=('GPL-2.0-or-later')
depends=('glibc' 'hicolor-icon-theme')
optdepends=('pipewire: screen capture on Wayland'
            'xdg-desktop-portal: screen capture on Wayland'
            'v4l2loopback-dkms: virtual camera')
provides=('hoppercast')
conflicts=('hoppercast')
options=('!strip' '!debug')
_appimage="HopperCast-release-${pkgver}-x86_64.AppImage"
source=("${_appimage}::${url}/releases/download/${_tag}/${_appimage}")
noextract=("${_appimage}")
sha256sums=('@SHA256@')

prepare() {
  chmod +x "${_appimage}"
  rm -rf squashfs-root
  "./${_appimage}" --appimage-extract >/dev/null
}

package() {
  install -dm755 "${pkgdir}/opt/hoppercast"
  cp -a squashfs-root/. "${pkgdir}/opt/hoppercast/"
  find "${pkgdir}/opt/hoppercast" -type d -exec chmod 755 {} +

  install -dm755 "${pkgdir}/usr/bin"
  printf '#!/bin/sh\nexec /opt/hoppercast/AppRun "$@"\n' > "${pkgdir}/usr/bin/hoppercast"
  chmod 755 "${pkgdir}/usr/bin/hoppercast"

  sed -e 's|^Exec=.*|Exec=hoppercast|' squashfs-root/hoppercast.desktop \
    | install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/hoppercast.desktop"
  install -Dm644 squashfs-root/hoppercast.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/hoppercast.png"
}
