# Hand-off: the author does not publish this. Whoever submits it to the AUR becomes its maintainer (see PACKAGING.md).
# Generated by the hopcast-app release job from hopcast/packaging/aur/PKGBUILD.in.
pkgname=hopcast-bin
pkgver=@PKGVER@
_tag=@TAG@
pkgrel=1
pkgdesc="Live streaming and recording studio for Linux: no account, no telemetry, any RTMP/SRT/RIST server"
arch=('x86_64')
url="https://github.com/theStyleWithin/hoppercast"
license=('GPL-2.0-or-later')
depends=('glibc' 'hicolor-icon-theme')
optdepends=('pipewire: screen capture on Wayland'
            'xdg-desktop-portal: screen capture on Wayland'
            'v4l2loopback-dkms: virtual camera')
provides=('hopcast')
conflicts=('hopcast')
options=('!strip' '!debug')
_appimage="HopCast-release-${pkgver}-x86_64.AppImage"
source=("${_appimage}::${url}/releases/download/${_tag}/${_appimage}")
noextract=("${_appimage}")
sha256sums=('@SHA256@')

prepare() {
  chmod +x "${_appimage}"
  rm -rf squashfs-root
  "./${_appimage}" --appimage-extract >/dev/null
}

package() {
  install -dm755 "${pkgdir}/opt/hopcast"
  cp -a squashfs-root/. "${pkgdir}/opt/hopcast/"
  find "${pkgdir}/opt/hopcast" -type d -exec chmod 755 {} +

  install -dm755 "${pkgdir}/usr/bin"
  printf '#!/bin/sh\nexec /opt/hopcast/AppRun "$@"\n' > "${pkgdir}/usr/bin/hopcast"
  chmod 755 "${pkgdir}/usr/bin/hopcast"

  sed -e 's|^Exec=.*|Exec=hopcast|' squashfs-root/hopcast.desktop \
    | install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/hopcast.desktop"
  install -Dm644 squashfs-root/hopcast.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/hopcast.png"
}
