# Flatpak hand-off for HopCast. Generated by the hopcast-app release job from
# hopcast/packaging/flatpak/manifest.yml.in. UNTESTED TEMPLATE: the author does not publish to Flathub;
# whoever submits it owns building, testing and maintaining it (see PACKAGING.md).
#
# This repackages the release AppImage (it bundles Qt and the streaming engine) instead of building
# from source, because the source build needs a custom OBS engine and a patched Qt app. If Flathub's
# reviewers want a from-source build, the complete source and build scripts are in hopcast-source-*.tar.gz
# (see hopcast/scripts/build-engine.sh and build-app.sh).
app-id: io.github.theStyleWithin.HopCast
runtime: org.freedesktop.Platform
runtime-version: '24.08'
sdk: org.freedesktop.Sdk
command: hopcast
finish-args:
  - --share=network
  - --share=ipc
  - --socket=x11
  - --socket=wayland
  - --socket=pulseaudio
  - --device=all
  - --filesystem=xdg-videos
  - --filesystem=xdg-pictures
modules:
  - name: hopcast
    buildsystem: simple
    build-commands:
      - chmod +x HopCast-release-@PKGVER@-x86_64.AppImage
      - ./HopCast-release-@PKGVER@-x86_64.AppImage --appimage-extract
      - cp -a squashfs-root /app/hopcast
      - install -Dm755 hopcast-launcher /app/bin/hopcast
      - sed -e 's|^Exec=.*|Exec=hopcast|' -e 's|^Icon=.*|Icon=io.github.theStyleWithin.HopCast|' squashfs-root/hopcast.desktop > io.github.theStyleWithin.HopCast.desktop
      - install -Dm644 io.github.theStyleWithin.HopCast.desktop /app/share/applications/io.github.theStyleWithin.HopCast.desktop
      - install -Dm644 squashfs-root/hopcast.png /app/share/icons/hicolor/256x256/apps/io.github.theStyleWithin.HopCast.png
      - install -Dm644 io.github.theStyleWithin.HopCast.metainfo.xml /app/share/metainfo/io.github.theStyleWithin.HopCast.metainfo.xml
    sources:
      - type: file
        url: https://github.com/theStyleWithin/hoppercast/releases/download/@TAG@/HopCast-release-@PKGVER@-x86_64.AppImage
        sha256: @SHA256@
      - type: script
        dest-filename: hopcast-launcher
        commands:
          - exec /app/hopcast/AppRun "$@"
      - type: file
        path: io.github.theStyleWithin.HopCast.metainfo.xml
