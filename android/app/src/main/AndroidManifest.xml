<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- only asked for when the microphone is switched on -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- only for the floating bubble; HopCast works without it -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <!-- lets HopCast list the apps you can put on the block list; no broad app-list permission needed -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <activity
        android:name=".BlocklistActivity"
        android:exported="false"
        android:screenOrientation="portrait" />

    <service
        android:name=".BlockWatcher"
        android:exported="false"
        android:label="@string/watcher_name"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/block_watcher" />
    </service>

    <service
        android:name=".CaptureService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection|microphone" />
  </application>
</manifest>
